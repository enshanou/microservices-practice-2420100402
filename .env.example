# Copy to .env and replace both password placeholders before starting.
APP_PORT=18080
MYSQL_DATABASE=courselens
MYSQL_USER=courselens
MYSQL_PASSWORD=replace_with_your_app_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password

# Week 07: replace locally in ignored .env; never commit real credentials.
NACOS_AUTH_TOKEN=replace_with_base64_of_at_least_32_random_bytes
NACOS_AUTH_IDENTITY_KEY=replace_with_your_identity_key
NACOS_AUTH_IDENTITY_VALUE=replace_with_your_identity_value
NACOS_USERNAME=nacos
NACOS_PASSWORD=replace_with_your_initialized_admin_password
NACOS_NAMESPACE=
NACOS_GROUP=COURSELENS_2420100402

# Week 09: node scripts/init-week09-auth.mjs fills these in the ignored .env.
GATEWAY_PORT=8080
WEEK09_AUTH_ENABLED=false
WEEK09_JWT_SECRET=
WEEK09_USER_PASSWORD_HASH=
WEEK09_ADMIN_PASSWORD_HASH=

# Optional model settings for subtitle notes (OpenAI-compatible base URL).
NOTES_API_BASE_URL=
NOTES_API_KEY=
NOTES_MODEL=

# Local video worker settings. Set a private shared token and absolute local paths.
# Optional providers. Leave model and key blank to hide a provider.
NOTES_DEEPSEEK_API_BASE_URL=
NOTES_DEEPSEEK_API_KEY=
NOTES_DEEPSEEK_MODEL=
NOTES_GPT_API_BASE_URL=
NOTES_GPT_API_KEY=
NOTES_GPT_MODEL=
NOTES_CLAUDE_API_BASE_URL=
NOTES_CLAUDE_API_KEY=
NOTES_CLAUDE_MODEL=
NOTES_KIMI_API_BASE_URL=
NOTES_KIMI_API_KEY=
NOTES_KIMI_MODEL=

VIDEO_WORKER_TOKEN=
VIDEO_PYTHON=
VIDEO_FFMPEG=
VIDEO_WHISPER_MODEL=
